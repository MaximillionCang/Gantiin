# Budget display reads Google Sheets. Fixture payouts stay disabled with a real budget.
INTEGRATION_MODE=fixture
BUDGET_SOURCE=google
APP_BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/runtime/gantiin.sqlite
WORKER_INTERVAL_MS=2500

# Sandbox only. Use a separate DB when switching from fixtures.
PAYPAL_MODE=sandbox
ENABLE_LIVE_PAYOUTS=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SANDBOX_MYR_FUNDING_CONFIRMED=false
PAYPAL_LOGIN_ENABLED=false
PAYPAL_SENDER_ACCOUNT_ID=

# Direct recovery is allowed only for synthetic fixtures on loopback, never Sandbox.
# Set false to disable the local demo shortcut. Normal password policy stays 12+.
DEMO_PASSWORD_RESET_ENABLED=true

# Dedicated Google test spreadsheet shared only with this service account.
# Keep the downloaded JSON outside the repository, and put its absolute path here.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPREADSHEET_ID=
# Used ONLY by the explicit empty-spreadsheet initialization command.
SHEETS_INITIAL_FUNDING_SEN=10000

# Select a supported vision/structured-output model and approve its usage first.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_OCR_MODEL=
GEMINI_DECIDER_MODEL=
AI_USAGE_AUTHORIZED=false
AI_MIN_CONFIDENCE=0.90

# Optional executable path for npm.cmd run start:https.
CLOUDFLARED_PATH=

# Optional separate Sandbox identity app for Treasurer login only.
PAYPAL_TREASURER_LOGIN_CLIENT_ID=
PAYPAL_TREASURER_LOGIN_CLIENT_SECRET=
