{
  "name": "gantiin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/src/server.mjs",
    "seed:demo": "node --env-file-if-exists=.env scripts/setup.mjs --demo",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "recipient:verify": "node --env-file-if-exists=.env scripts/recipient.mjs",
    "integrations:probe": "node --env-file-if-exists=.env scripts/probe.mjs",
    "ai:check": "node --env-file-if-exists=.env scripts/check-ai.mjs",
    "sheets:setup": "node --env-file-if-exists=.env scripts/sheets-setup.mjs --initialize-empty",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "start:sandbox": "node --env-file-if-exists=.env --env-file=.env.sandbox apps/api/src/server.mjs",
    "start:https": "node --env-file-if-exists=.env --env-file=.env.sandbox scripts/start-https.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/google": "^0.2.12",
    "google-auth-library": "^11.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0"
  }
}
